// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      String   @default("student")
  exams     Exam[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Exam {
 id                    String          @id
  userId                String?         @map("user_id")
  user                  User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  examTitle             String          @map("exam_title")
  examMode              String          @map("exam_mode") // 'offline' or 'online'
  durationMinutes       Int             @map("duration_minutes")
  totalQuestions        Int             @map("total_questions")
  passingMarks          Int             @map("passing_marks")
  enableNegativeMarking Boolean         @default(false) @map("enable_negative_marking")
  negativeMarkValue     Decimal?        @default(0.00) @map("negative_mark_value") @db.Decimal(4, 2)
  enableSets            Boolean         @default(false) @map("enable_sets")
  enableSectionalCutoff Boolean         @default(false) @map("enable_sectional_cutoff")
  examSet               String?         @map("exam_set")
  instructions          String?         @db.Text
  subjects              Json?           // Stores array of subject sections
  questionPaper         Json?           @map("question_paper") // Stores structured questions
  answerKey             Json?           @map("answer_key") // Stores correct answers
  studentRecords        StudentRecord[]
  createdAt             DateTime        @default(now()) @map("created_at")
  @@map("exams")
}

model StudentRecord {
  id          String   @id
  examId      String   @map("exam_id")
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  name        String
  rollNo      String   @map("roll_no")
  attendance  String   @default("absent") @map("attendance") // "present" | "absent"
  checkedIn   Boolean  @default(false) @map("checked_in")
  checkInTime String?  @map("check_in_time")
  bookletSet  String?  @map("booklet_set")
  submittedAt String?  @map("submitted_at")
  omrScanned  Boolean  @default(false) @map("omr_scanned")
  omrImageUrl String?  @map("omr_image_url")
  marksScored Float?   @map("marks_scored")
  maxMarks    Float?   @map("max_marks")
  passed      Boolean?

  @@index([examId])
  @@map("student_records")
}

model ApiRateLimit {
  identifier   String   @id
  requestCount Int      @map("request_count")
  windowStart  BigInt   @map("window_start") // Epoch timestamp in milliseconds

  @@map("api_rate_limits")
}

model ManagerEvent {
  id                 Int      @id @default(autoincrement())
  managerIdentifier  String   @map("manager_identifier")
  eventId            Int      @map("event_id")
  assignedAt         DateTime @default(now()) @map("assigned_at")

  @@index([managerIdentifier])
  @@map("manager_events")
}